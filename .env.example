# Application
APP_ENV=development
DEBUG=true
APP_NAME="Gym Management System"
API_PREFIX=/api/v1

# Database (PostgreSQL, asyncpg driver)
DATABASE_URL=postgresql+asyncpg://gym:gym@localhost:5432/gym
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5
DATABASE_ECHO=false

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT (RS256 asymmetric signing)
# Generate a keypair with:
#   openssl genrsa -out jwt_private.pem 2048
#   openssl rsa -in jwt_private.pem -pubout -out jwt_public.pem
# Then paste the PEM contents below with literal \n newlines, or point to files
# via JWT_PRIVATE_KEY_PATH / JWT_PUBLIC_KEY_PATH instead.
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY_PATH=./secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=./secrets/jwt_public.pem
JWT_ISSUER=gym-backend
JWT_AUDIENCE=gym-mobile-app
ACCESS_TOKEN_EXPIRE_MINUTES=20
REFRESH_TOKEN_EXPIRE_DAYS=14

# CORS (comma separated list of allowed origins, no wildcard in production)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Rate limiting
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_REGISTER_PER_MINUTE=3
RATE_LIMIT_DEFAULT_PER_MINUTE=120

# Only used by the Docker image's CMD (uvicorn --proxy-headers). Set to your
# reverse proxy/load balancer's IP or CIDR in production so rate limiting
# and audit-log IPs reflect the real client, not the proxy. Leave at the
# default if the API is exposed directly with no proxy in front.
FORWARDED_ALLOW_IPS=127.0.0.1

# Object storage (S3-compatible). Leave blank to use local disk storage.
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./uploads
STORAGE_BUCKET=gym-uploads
STORAGE_ENDPOINT=
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_BASE_URL=http://localhost:8000/uploads

# Admin bootstrap (used only by scripts/create_admin.py)
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe!12345

# Notifications provider (fcm | none)
PUSH_PROVIDER=none
FCM_SERVICE_ACCOUNT_JSON=
