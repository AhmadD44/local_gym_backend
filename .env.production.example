# Production environment template. Copy to `.env.production` on the server
# and fill in every value below — do NOT reuse any value from .env.example
# or your local .env (those are dev-only placeholders). See DEPLOYMENT.md.
#
#   cp .env.production.example .env.production

# --- Domain / TLS (read by Caddy, see docker-compose.prod.yml) -------------
DOMAIN=api.yourdomain.com
ACME_EMAIL=you@yourdomain.com

# --- Application -------------------------------------------------------
APP_ENV=production
DEBUG=false
APP_NAME="Gym Management System"
API_PREFIX=/api/v1

# --- Database ------------------------------------------------------------
# POSTGRES_USER/DB can stay as-is; POSTGRES_PASSWORD MUST be a strong,
# freshly generated value (e.g. `openssl rand -base64 32`), never "gym".
# DATABASE_URL is assembled automatically in docker-compose.prod.yml from
# these three — don't set it here.
POSTGRES_USER=gym
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_A_STRONG_RANDOM_VALUE
POSTGRES_DB=gym
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5
DATABASE_ECHO=false

# REDIS_URL is hardcoded to redis://redis:6379/0 in docker-compose.prod.yml
# (Redis has no auth in this stack since it's not exposed outside the
# private compose network — do not publish its port).

# --- JWT (RS256) -----------------------------------------------------------
# Generate a NEW keypair for production — never reuse the one in your local
# ./secrets/ directory:
#   python -m scripts.generate_jwt_keys
# then copy the resulting secrets/ directory to the server (see
# DEPLOYMENT.md) — it's bind-mounted read-only by docker-compose.prod.yml,
# never baked into the image or committed to git.
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY_PATH=./secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=./secrets/jwt_public.pem
JWT_ISSUER=gym-backend
JWT_AUDIENCE=gym-mobile-app
ACCESS_TOKEN_EXPIRE_MINUTES=20
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- CORS ------------------------------------------------------------------
# Your actual Flutter web origin(s) if you ship a web build, and/or your
# admin panel's origin. Native mobile apps (Android/iOS) don't send an
# Origin header and aren't affected by CORS at all — leave this empty
# (or a single placeholder) if you only ever call the API from the mobile
# app. Never use "*".
CORS_ORIGINS=

# --- Rate limiting -----------------------------------------------------
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_REGISTER_PER_MINUTE=3
RATE_LIMIT_DEFAULT_PER_MINUTE=120

# --- Object storage ----------------------------------------------------
# Local disk works for a single server (uploads persist in the
# uploads_data volume) but won't survive moving to multiple instances.
# Switch to S3-compatible storage (AWS S3, Cloudflare R2, Backblaze B2,
# MinIO, ...) when you need that:
#   STORAGE_BACKEND=s3
#   STORAGE_BUCKET=your-bucket
#   STORAGE_ENDPOINT=https://... (leave blank for real AWS S3)
#   STORAGE_REGION=...
#   STORAGE_ACCESS_KEY=...
#   STORAGE_SECRET_KEY=...
#   STORAGE_PUBLIC_BASE_URL=https://your-bucket.s3.amazonaws.com  (or your CDN)
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./uploads
STORAGE_BUCKET=gym-uploads
STORAGE_ENDPOINT=
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_BASE_URL=https://api.yourdomain.com/uploads

# --- Admin bootstrap (used once, by scripts/create_admin.py) ---------------
# Change BOOTSTRAP_ADMIN_PASSWORD to a strong value before first run, and
# change it again via the app immediately after logging in the first time.
BOOTSTRAP_ADMIN_EMAIL=admin@yourdomain.com
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- Push notifications ------------------------------------------------
# Leave as "none" until you've created a Firebase project and downloaded a
# service account JSON; then set PUSH_PROVIDER=fcm and paste the JSON
# (single line) into FCM_SERVICE_ACCOUNT_JSON.
PUSH_PROVIDER=none
FCM_SERVICE_ACCOUNT_JSON=

# --- Email (password reset) -------------------------------------------
# Not yet wired into the application code (see DEPLOYMENT.md "known gap").
# Until this is implemented, forgot-password has no real delivery
# mechanism in production (DEBUG=false correctly disables the debug-token
# shortcut too) — password resets won't work end-to-end for real users
# until an email provider is integrated.
